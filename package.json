{
  "name": "fuelos",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/worker",
    "dev:owner": "npm run dev -w apps/owner-web",
    "dev:customer": "npm run dev -w apps/customer",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "tokens": "npm run tokens -w packages/ui",
    "test": "npm run test --workspaces --if-present"
  },
  "engines": {
    "node": ">=20"
  }
}
